{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "native_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Type"
    },
    "provider": {
      "enum": [
        "codex",
        "claude"
      ],
      "title": "Provider",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "timestamp": {
      "title": "Timestamp",
      "type": "string"
    },
    "type": {
      "enum": [
        "session.started",
        "progress",
        "tool",
        "usage",
        "completed",
        "failed",
        "diagnostic"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "provider"
  ],
  "title": "AgentEvent",
  "type": "object"
}
