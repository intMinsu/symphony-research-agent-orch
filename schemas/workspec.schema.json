{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "evidence"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Research": {
      "additionalProperties": false,
      "properties": {
        "artifact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Paths",
          "type": "array"
        },
        "datasets": {
          "items": {
            "type": "string"
          },
          "title": "Datasets",
          "type": "array"
        },
        "hypothesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypothesis"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "title": "Seeds",
          "type": "array"
        }
      },
      "title": "Research",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "include": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Include",
          "type": "array"
        }
      },
      "required": [
        "include"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "default": "codex",
          "enum": [
            "codex",
            "claude"
          ],
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "Selection",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "minItems": 1,
      "title": "Acceptance",
      "type": "array"
    },
    "check_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
        "type": "string"
      },
      "title": "Check Ids",
      "type": "array"
    },
    "delivery": {
      "default": "draft_pr",
      "enum": [
        "draft_pr",
        "report"
      ],
      "title": "Delivery",
      "type": "string"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/Selection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "default": "implementation",
      "enum": [
        "implementation",
        "experiment",
        "investigation"
      ],
      "title": "Kind",
      "type": "string"
    },
    "non_goals": {
      "items": {
        "type": "string"
      },
      "title": "Non Goals",
      "type": "array"
    },
    "objective": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "research": {
      "$ref": "#/$defs/Research"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "stop_conditions": {
      "items": {
        "type": "string"
      },
      "title": "Stop Conditions",
      "type": "array"
    },
    "title": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "objective",
    "scope",
    "acceptance"
  ],
  "title": "WorkSpec",
  "type": "object"
}
